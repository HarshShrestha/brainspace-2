# Serves the SPA and reverse-proxies /api to the API on the same origin (required by the
# SameSite=Lax session cookie). ${API_UPSTREAM} is substituted at container start.

# Share-link tokens are bearer secrets in the URL path: never write them to access logs.
map $request_uri $loggable {
    ~^/shared/         0;
    ~^/api/v1/shared/  0;
    default            1;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    access_log /var/log/nginx/access.log combined if=$loggable;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    include /etc/nginx/snippets/security-headers.conf;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        # AI requests may take up to RAG_TIMEOUT_MS (120 s by default).
        proxy_read_timeout 150s;
        client_max_body_size 512k;
    }

    # Content-hashed build output can be cached forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # Client-side routes (e.g. /shared/<token>, /folders/<id>) fall back to the app shell.
    location / {
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri $uri/ /index.html;
    }
}
