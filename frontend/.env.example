# Frontend build-time configuration. Values are embedded in the public bundle: never put secrets here.

# Base URL of the API. Keep the same-origin default in production (the reverse proxy routes /api).
VITE_API_URL=/api/v1

# Development only: where the Vite dev server proxies /api (defaults to http://localhost:8000).
# VITE_DEV_API_PROXY=http://localhost:8000
