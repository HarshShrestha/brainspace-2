# BrainSpace API configuration. Copy to .env for local development.
# Never commit real secrets. Every variable is validated at startup (src/config/environment.ts).

NODE_ENV=development
PORT=8000
LOG_LEVEL=info

# MongoDB connection string including the database name.
MONGODB_URI=mongodb://127.0.0.1:27017/brainspace

# At least 32 random characters, e.g. `openssl rand -hex 32`. Rotating it signs everyone out.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Session lifetime in days.
SESSION_TTL_DAYS=7

# Comma-separated list of exact browser origins allowed to call the API (no trailing slash).
CORS_ORIGINS=http://localhost:5173

# Public origin of the web app; used to build share links. Defaults to the first CORS origin.
# PUBLIC_APP_URL=http://localhost:5173

# Set only when running behind a known number of trusted reverse proxies (1-10).
# TRUST_PROXY_HOPS=1

# ---- Optional AI assistant (off by default) ----
# Indexing and questions send text to Google Gemini and may incur charges.
RAG_ENABLED=false
# GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3.8-flash
# Python 3.10+ executable and the directory containing the `brainspace_rag` package.
# RAG_PYTHON=python3
# RAG_WORKER_DIR=../rag
# Hard deadline for one worker call, and the maximum number of concurrent worker processes.
RAG_TIMEOUT_MS=120000
RAG_MAX_CONCURRENCY=4
